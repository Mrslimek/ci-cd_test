# Скопируйте в .env для локального запуска без Docker (uv run uvicorn app.main:app --reload).
# В docker compose эти значения задаются прямо в environment сервиса api и имеют приоритет.

# Локальный Postgres из docker compose проброшен на порт хоста 5433
# (5432 часто занят локальным Postgres).
DATABASE_URL=postgresql+asyncpg://graphql:graphql@localhost:5433/graphql

# Логировать каждый SQL-запрос SQLAlchemy (демо N+1).
LOG_SQL=true
